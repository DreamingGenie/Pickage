# Copy to collector/.env.local and fill only the providers you will call.
# Never commit real values or complete request URLs containing a key.

# data.go.kr Seoul bus arrival/position and public-transit path lookup
# Use the Decoding key; the collector URL-encodes query parameters once.
DATA_GO_BUS_API_KEY=

# Seoul Open Data general and subway-realtime credentials
SEOUL_OPEN_API_KEY=
SEOUL_SUBWAY_REALTIME_KEY=

# Seoul T-DATA
T_DATA_API_KEY=

# data.go.kr KMA ASOS / village forecast services (Decoding key)
DATA_GO_KMA_API_KEY=

# Optional third-party runtime route discovery providers
KAKAO_MAP_REST_API_KEY=
TMAP_APP_KEY=
