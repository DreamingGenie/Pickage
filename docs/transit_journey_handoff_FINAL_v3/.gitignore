# Scoped to this handoff package only.
# .env.local / __pycache__ are covered repo-wide by the root .gitignore.

# Bulk raw API samples collected during spikes: too large/noisy for git.
# Curate a few representative examples manually with `git add -f` when writing the Phase 0 report.
data/samples/**
!data/samples/.gitkeep
!data/samples/examples/
!data/samples/examples/**
