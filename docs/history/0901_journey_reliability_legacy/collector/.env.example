# 실제 값은 절대 커밋하지 않는다. collector/.env.local로 복사해 채운다.
# .env.local은 .gitignore 대상이다.

# ── 서울 열린데이터광장 ───────────────────────────────────────────────
# 지하철 실시간 전용 인증키.
# OA-15799(일괄 도착) · OA-12601(열차 위치) · OA-12764(역별 도착)가
# 이 키 1개의 1일 1,000회 한도를 **공유**한다.
# 스모크 테스트만 할 때는 값 대신 sample 을 넣어도 된다(반환 행 수 제한).
SEOUL_SUBWAY_REALTIME_KEY=

# 지하철 도착정보(일괄) OA-15799 전용 키.
# 위치와 다른 키를 써서 위치 예산과 분리한다(한도는 인증키 단위 = 별도 950/일).
# 1콜에 19노선 전부. arvlCd=1(도착)+recptnDt가 실제 도착 이벤트다.
SEOUL_SUBWAY_ARRIVAL_ALL_KEY=
# 팀원 일괄 키(rotation). 주기를 낮춰 촘촘히 하려면 여기 채운다.
#   1키 95초 → 3키 30초 → 6키 20초. 도착 이벤트를 거의 다 잡는다.
# ⚠️ 반드시 '일괄 서비스 권한'이 있는 키여야 한다. 없으면 ERROR-340 → 당일 자동 중단.
SEOUL_SUBWAY_ARRIVAL_ALL_KEY_2=
SEOUL_SUBWAY_ARRIVAL_ALL_KEY_3=
SEOUL_SUBWAY_ARRIVAL_ALL_KEY_4=
SEOUL_SUBWAY_ARRIVAL_ALL_KEY_5=
SEOUL_SUBWAY_ARRIVAL_ALL_KEY_6=

# 일반 인증키. 도로소통(OA-13291)·돌발(OA-13315)·알림(OA-22718)용.
# 해당 API들은 현재 openapi.seoul.go.kr:8088 접근 차단으로 보류 상태다.
SEOUL_OPEN_API_KEY=

# ── 팀원 지하철 키 (key rotation) ────────────────────────────────────
# 지하철 실시간은 인증키 1개당 1일 1,000회 공유 한도라, 팀원 키를 함께 쓰면
# 그만큼 하루 예산이 배가 된다(내 키 소진 → _2 → _3 ... 자동 전환).
# 규칙:
#   - 번호를 건너뛰지 않는다. _2 없이 _3만 넣으면 _3은 무시된다(빈 번호에서 멈춤).
#   - 값을 채운 변수만 유효하다. 빈 채로 두면 그 키는 없는 것으로 친다.
#   - 같은 값을 두 변수에 넣으면 원장에서 같은 카운터라 예산이 늘지 않는다.
#   - 팀원에게는 1:1로만 키를 받고, 그 값을 채팅·커밋·로그에 붙여넣지 않는다.
SEOUL_SUBWAY_REALTIME_KEY_2=
SEOUL_SUBWAY_REALTIME_KEY_3=
SEOUL_SUBWAY_REALTIME_KEY_4=
SEOUL_SUBWAY_REALTIME_KEY_5=
SEOUL_SUBWAY_REALTIME_KEY_6=

# ── data.go.kr ────────────────────────────────────────────────────────
# 버스 도착·위치 공통 계정 키. 상세기능마다 1,000/day 독립 quota이며
# 지하철 키와는 별도 풀이다.
#
# ⚠️ data.go.kr 마이페이지는 인증키를 `인코딩키`와 `디코딩키` 두 가지로 보여준다.
#    여기에는 반드시 **디코딩키**(원본, %가 없는 쪽)를 넣는다.
#    수집기가 요청을 만들 때 키를 다시 인코딩하므로, 인코딩키를 넣으면
#    이중 인코딩되어 HTTP 401이 난다.
DATA_GO_BUS_API_KEY=

# ── 팀원 버스 키 (key rotation) ──────────────────────────────────────
# 버스는 노선 단위 호출이라 많은 노선을 받으려면 예산이 곧 노선 수다.
# 팀원 data.go.kr 키를 _2 ~ _6 에 넣으면 하루 예산이 키 수만큼 배가 되어
# 그만큼 노선을 더 담을 수 있다(위 지하철과 같은 규칙, 반드시 **디코딩키**).
# 팀원도 아래 두 서비스를 각각 활용신청해야 한다:
#   - 서울특별시_버스도착정보조회 서비스 (개발계정)
#   - 서울특별시_버스위치정보조회 서비스 (개발계정)
DATA_GO_BUS_API_KEY_2=
DATA_GO_BUS_API_KEY_3=
DATA_GO_BUS_API_KEY_4=
DATA_GO_BUS_API_KEY_5=
DATA_GO_BUS_API_KEY_6=

# 기상청 ASOS 시간자료 / 단기예보용. data.go.kr 동일 계정 키를 쓸 수 있다.
DATA_GO_KMA_API_KEY=

# ── 서울교통공사 신규 개방 API (data.go.kr, 2025-07 개방분) ───────────
# 지하철 환승 동선 데이터. 네이버·카카오가 보여주는 "빠른 환승 4-2" 정보의 출처다.
#   - 빠른하차정보     (15143840) 계단·엘리베이터 최근접 하차칸·문 번호
#   - 최단경로이동정보 (15143842) 최소시간·최단거리·최소환승 경로와 구간별 소요시간
#
# data.go.kr 인증키는 계정당 1개라 DATA_GO_BUS_API_KEY와 값이 같을 수 있다.
# 그래도 변수를 나누는 이유는 quota가 활용신청(상세기능) 단위로 독립이어서,
# 원장 카운터를 분리해야 실제 잔여 호출량이 맞게 집계되기 때문이다.
# 여기에도 반드시 **디코딩키**(%가 없는 쪽)를 넣는다. 위 경고와 같은 이유다.
DATA_GO_SUBWAY_API_KEY=

# ── 경로 provider ─────────────────────────────────────────────────────
# WALK 구간 전용. 대중교통 경로 탐색은 structure-only로만 사용한다.
KAKAO_MAP_REST_API_KEY=

# ── 런타임 ────────────────────────────────────────────────────────────
APP_ENV=local
TZ=Asia/Seoul
BRONZE_DIR=./data/bronze
