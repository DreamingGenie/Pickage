 "info": {
  "description": "Pickage API 문서",
  "title": "Pickage API",
  "version": "v1"
 },
 "openapi": "3.1.0",
 "paths": {
  "/api/packages": {
   "get": {
    "description": "이름 배열(최대 3개)로 조회한다. 일부가 없어도 200 이며 not_found 에 담긴다. 패키지는 있으나 스냅샷이 없으면 items 에 포함되고 지표 필드만 null 이다.",
    "operationId": "getOverview",
    "parameters": [
     {
      "in": "query",
      "name": "names",
      "required": false,
      "schema": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "*/*": {
        "schema": {
         "oneOf": [
          {
           "$ref": "#/components/schemas/FailedResponseBody"
          },
          {
           "$ref": "#/components/schemas/SuccessResponseBody"
          }
         ]
        }
       }
      },
      "description": "OK"
     }
    },
    "summary": "패키지 개요",
    "tags": [
     "packages"
    ]
   }
  },
  "/api/packages/community": {
   "get": {
    "description": "진행 상태 또는 저장된 결과만 읽는다. 새 수집을 시작하지 않는다.",
    "operationId": "getStatus",
    "parameters": [
     {
      "in": "query",
      "name": "name",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "*/*": {
        "schema": {
         "oneOf": [
          {
           "$ref": "#/components/schemas/FailedResponseBody"
          },
          {
           "$ref": "#/components/schemas/SuccessResponseBody"
          }
         ]
        }
       }
      },
      "description": "OK"
     }
    },
    "summary": "커뮤니티 현황 조회",
    "tags": [
     "community"
    ]
   }
  },
  "/api/packages/community/refresh": {
   "post": {
    "description": "새 작업을 수락하면 202, 이미 신선한 결과가 있거나 같은 작업에 참여하거나 용량이 초과되면 200이다.",
    "operationId": "refresh",
    "parameters": [
     {
      "in": "query",
      "name": "name",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "in": "query",
      "name": "trigger",
      "required": true,
      "schema": {
       "enum": [
        "ANALYSIS_CONFIRMED",
        "TAB_OPENED"
       ],
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "*/*": {
        "schema": {
         "oneOf": [
          {
           "$ref": "#/components/schemas/FailedResponseBody"
          },
          {
           "$ref": "#/components/schemas/SuccessResponseBody"
          }
         ]
        }
       }
      },
      "description": "OK"
     }
    },
    "summary": "커뮤니티 현황 갱신",
    "tags": [
     "community"
    ]
   }
  },
  "/api/packages/dependents": {
   "get": {
    "description": "스냅샷별로 전 버전의 dependents_count 를 합산한다. 절대수는 부풀려진 값이다.",
    "operationId": "getDependentsTrend",
    "parameters": [
     {
      "in": "query",
      "name": "names",
      "required": false,
      "schema": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     {
      "in": "query",
      "name": "from",
      "required": false,
      "schema": {
       "format": "date",
       "type": "string"
      }
     },
     {
      "in": "query",
      "name": "to",
      "required": false,
      "schema": {
       "format": "date",
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "*/*": {
        "schema": {
         "oneOf": [
          {
           "$ref": "#/components/schemas/FailedResponseBody"
          },
          {
           "$ref": "#/components/schemas/SuccessResponseBody"
          }
         ]
        }
       }
      },
      "description": "OK"
     }
    },
    "summary": "의존 수 추이",
    "tags": [
     "packages"
    ]
   }
  },
  "/api/packages/downloads": {
   "get": {
    "description": "from 생략 시 최초 스냅샷, to 생략 시 최신 스냅샷. 기간 상한 없음.",
    "operationId": "getDownloadsTrend",
    "parameters": [
     {
      "in": "query",
      "name": "names",
      "required": false,
      "schema": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     {
      "in": "query",
      "name": "from",
      "required": false,
      "schema": {
       "format": "date",
       "type": "string"
      }
     },
     {
      "in": "query",
      "name": "to",
      "required": false,
      "schema": {
       "format": "date",
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "*/*": {
        "schema": {
         "oneOf": [
          {
           "$ref": "#/components/schemas/FailedResponseBody"
          },
          {
           "$ref": "#/components/schemas/SuccessResponseBody"
          }
         ]
        }
       }
      },
      "description": "OK"
     }
    },
    "summary": "다운로드 추이",
    "tags": [
     "packages"
    ]
   }
  },
  "/api/packages/env": {
   "get": {
    "description": "이름@버전 배열(최대 3개). 모듈 방식·타입 동봉·직접/peer 의존 수를 돌려준다. 없는 것은 not_found 에 담기고 200 이다.",
    "operationId": "getEnv",
    "parameters": [
     {
      "in": "query",
      "name": "refs",
      "required": false,
      "schema": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "*/*": {
        "schema": {
         "oneOf": [
          {
           "$ref": "#/components/schemas/FailedResponseBody"
          },
          {
           "$ref": "#/components/schemas/SuccessResponseBody"
          }
         ]
        }
       }
      },
      "description": "OK"
     }
    },
    "summary": "버전별 소비 조건",
    "tags": [
     "features"
    ]
   }
  },
  "/api/packages/feature-comparison": {
   "post": {
    "description": "runId 를 돌려준다. 결과는 상태 조회로 받는다. 동시 실행 수를 넘으면 V002.",
    "operationId": "startComparison",
    "parameters": [
     {
      "in": "query",
      "name": "refs",
      "required": false,
      "schema": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "*/*": {
        "schema": {
         "oneOf": [
          {
           "$ref": "#/components/schemas/FailedResponseBody"
          },
          {
           "$ref": "#/components/schemas/SuccessResponseBody"
          }
         ]
        }
       }
      },
      "description": "OK"
     }
    },
    "summary": "기능 비교 시작",
    "tags": [
     "features"
    ]
   }
  },
  "/api/packages/feature-comparison/{runId}": {
   "get": {
    "description": "COMPLETED 면 result 가 찬다. 실패도 200 이며 status=FAILED · error_code 로 구분한다.",
    "operationId": "getComparison",
    "parameters": [
     {
      "in": "path",
      "name": "runId",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "*/*": {
        "schema": {
         "oneOf": [
          {
           "$ref": "#/components/schemas/FailedResponseBody"
          },
          {
           "$ref": "#/components/schemas/SuccessResponseBody"
          }
         ]
        }
       }
      },
      "description": "OK"
     }
    },
    "summary": "기능 비교 상태",
    "tags": [
     "features"
    ]
   }
  },
  "/api/packages/migration-pairs": {
   "get": {
    "description": "X 를 뺀 릴리스가 무엇을 함께 넣었는지를 도착지 분포로 답한다. kind 는 regular·dev 중 하나이며 기본 regular — 모집단이 달라 두 종류의 수를 더하거나 lift 절댓값을 비교하면 안 된다. 기본 필터(votes>=5 AND publisher_months>=3)를 통과한 상위 5개를 세우고 나머지는 etc 로 접는다. 점유율 분모는 표가 아니라 조직·달 수(share_basis=publisher_months)이며 한 응답의 합이 100 이 아니다. 쌍은 있으나 전부 필터 미달이면 INSUFFICIENT_EVIDENCE, 관측이 없으면 NO_DATA, available_package 에 없으면 OUT_OF_SCOPE, 그 종류를 아직 안 올렸으면 NOT_COMPUTED 로 나간다.",
    "operationId": "getMigrationPairs",
    "parameters": [
     {
      "in": "query",
      "name": "names",
      "required": false,
      "schema": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     {
      "in": "query",
      "name": "kind",
      "required": false,
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "*/*": {
        "schema": {
         "oneOf": [
          {
           "$ref": "#/components/schemas/FailedResponseBody"
          },
          {
           "$ref": "#/components/schemas/SuccessResponseBody"
          }
         ]
        }
       }
      },
      "description": "OK"
     }
    },
    "summary": "관측된 교체 흐름 (도착지 분포)",
    "tags": [
     "packages"
    ]
   }
  },
  "/api/packages/removal-reasons": {
   "get": {
    "description": "X 를 뺀 전이를 대체 동반(with_replacement)과 대체 없음(no_replacement)으로 가른다. period 는 1y·3y·5y 중 하나이며 기본 3y. 한 패키지가 한 줄이다(kind 없음). unit=transitions — 패키지 수가 아니라 전이 건수이며 유지·유입·이탈의 수와 더하거나 나누면 안 된다. 대상인데 제거가 없으면 0 과 NO_DATA, 대상 밖이면 null 과 OUT_OF_SCOPE 로 나간다.",
    "operationId": "getRemovalReasons",
    "parameters": [
     {
      "in": "query",
      "name": "names",
      "required": false,
      "schema": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     {
      "in": "query",
      "name": "period",
      "required": false,
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "*/*": {
        "schema": {
         "oneOf": [
          {
           "$ref": "#/components/schemas/FailedResponseBody"
          },
          {
           "$ref": "#/components/schemas/SuccessResponseBody"
          }
         ]
        }
       }
      },
      "description": "OK"
     }
    },
    "summary": "구간별 이탈 사유",
    "tags": [
     "packages"
    ]
   }
  },
  "/api/packages/search": {
   "get": {
    "description": "최신 스냅샷이 있는 등록 패키지만 반환한다. 완전 일치·접두사·중간 포함 순, 같은 그룹은 다운로드 순. limit 기본 20, 최대 50.",
    "operationId": "search",
    "parameters": [
     {
      "in": "query",
      "name": "q",
      "required": false,
      "schema": {
       "type": "string"
      }
     },
     {
      "in": "query",
      "name": "limit",
      "required": false,
      "schema": {
       "format": "int32",
       "type": "integer"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "*/*": {
        "schema": {
         "oneOf": [
          {
           "$ref": "#/components/schemas/FailedResponseBody"
          },
          {
           "$ref": "#/components/schemas/SuccessResponseBody"
          }
         ]
        }
       }
      },
      "description": "OK"
     }
    },
    "summary": "등록된 패키지명 검색 (포함)",
    "tags": [
     "packages"
    ]
   }
  },
  "/api/packages/similar": {
   "get": {
    "description": "기준 패키지 하나의 대체 후보를 순위 순으로 반환한다. limit 기본 20, 최대 50. 아직 계산되지 않았으면 200 에 빈 candidates 와 data_status=NO_DATA 로 나간다.",
    "operationId": "getSimilar",
    "parameters": [
     {
      "in": "query",
      "name": "name",
      "required": false,
      "schema": {
       "type": "string"
      }
     },
     {
      "in": "query",
      "name": "limit",
      "required": false,
      "schema": {
       "format": "int32",
       "type": "integer"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "*/*": {
        "schema": {
         "oneOf": [
          {
           "$ref": "#/components/schemas/FailedResponseBody"
          },
          {
           "$ref": "#/components/schemas/SuccessResponseBody"
          }
