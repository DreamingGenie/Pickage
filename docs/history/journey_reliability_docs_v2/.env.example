# Never commit real values.
# Copy to .env.local or inject via GitLab/Jenkins/EC2 secret management.

SEOUL_OPEN_API_KEY=
SEOUL_SUBWAY_REALTIME_KEY=

# One shared account-level key covers all data.go.kr bus services for this
# account - confirmed byte-identical across arrival/position/route/mixed-route
# (D-013). If a future service/account issues a different value, split this
# back into per-service names (bus_arrival_spike.py etc. each call
# require_key() once - just point the ones that diverge at a new var).
DATA_GO_BUS_API_KEY=

# WALK/access utility exception only; Transit Reliability Core remains Seoul public-transit data (PD-003/PD-004/PD-022).
# Kakao Mobility walking directions: BLOCKED in current evidence; keep blank unless policy/source is re-approved.
KAKAO_MAP_REST_API_KEY=
# TMAP pedestrian route utility: VERIFIED for point-route calls; not a transit reliability label source. Must subscribe to
# the "보행자 경로 안내" product under your app on openapi.sk.com, not just create the app.
TMAP_APP_KEY=

# Runtime
APP_ENV=local
TZ=Asia/Seoul
RAW_DATA_DIR=./data/raw
SAMPLE_DATA_DIR=./data/samples
