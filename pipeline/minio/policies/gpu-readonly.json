{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::pickage-raw",
        "arn:aws:s3:::pickage-curated"
      ]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": [
        "arn:aws:s3:::pickage-raw/*",
        "arn:aws:s3:::pickage-curated/*"
      ]
    }
  ]
}
