{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadTrainingInputs",
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::pickage-raw",
        "arn:aws:s3:::pickage-curated"
      ]
    },
    {
      "Sid": "ReadTrainingInputObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": [
        "arn:aws:s3:::pickage-raw/*",
        "arn:aws:s3:::pickage-curated/*"
      ]
    },
    {
      "Sid": "WriteModelArtifacts",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket",
        "s3:ListBucketMultipartUploads"
      ],
      "Resource": ["arn:aws:s3:::pickage-mlflow-artifacts"]
    },
    {
      "Sid": "WriteModelArtifactObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": ["arn:aws:s3:::pickage-mlflow-artifacts/*"]
    }
  ]
}
