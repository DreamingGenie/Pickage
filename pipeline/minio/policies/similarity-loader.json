{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadSimilarityResults",
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation", "s3:ListBucket"],
      "Resource": ["arn:aws:s3:::pickage-vectors"]
    },
    {
      "Sid": "ReadSimilarityResultObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": ["arn:aws:s3:::pickage-vectors/*"]
    }
  ]
}
