# data 노드 **안에서** 도는 컨테이너가 쓰는 MinIO 자격증명.
#
#   data 노드에서:  cp pipeline/minio/.env.data.example pipeline/minio/.env.data
#
# 주간 수집 컨테이너(deploy/prod/data/compose.yaml 의 ingest-weekly)가
# PICKAGE_MINIO_ENV=.env.data 로 이 파일을 고른다.
#
# ⚠ 이건 **서버에 두는 파일**이다. 내 PC 에 만들 일이 없다.
#   로컬에서 서버 MinIO 에 적재하려는 것이라면 .env.server 다 (터널 경유, 19000).
#
# 세 파일이 같은 MinIO 를 가리키지만 가는 길이 다르다.
#
#   .env         내 PC 의 로컬 MinIO          http://localhost:9000
#   .env.server  내 PC → SSH 터널 → 서버      http://localhost:19000
#   .env.data    서버 안의 컨테이너 → 서버     http://minio:9000   ← 이 파일
#
# ⚠ 값을 여기 적지 말고 .env.data 에 채운다. 이 파일은 커밋된다.
#
# 값은 같은 노드의 MinIO 에서 꺼낸다:
#   docker inspect pickage-data-minio-1 --format '{{range .Config.Env}}{{println .}}{{end}}' | grep MINIO_ROOT
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# ── 서비스 이름으로 붙는다. 사설 IP 가 아니다 ────────────────
#
# 수집 컨테이너와 MinIO 가 **같은 호스트의 같은 compose 네트워크**에 있다. 그래서
# 이름으로 풀린다. 이것이 09-15 재설계의 실질 이득 하나다 — app 노드에서 돌 때는
# Bronze 수 GB 를 사설 IP(172.26.8.249:9000)로 보냈고, 검증 GET 까지 왕복 약 20 GB 였다.
#
# ⚠ MINIO_ENDPOINT 라는 이름을 쓰지 말 것. 그 이름은 init-buckets.sh 가 쓰는 것이라
#   겹치면 그쪽이 엉뚱한 주소로 붙는다.
PICKAGE_S3_ENDPOINT=http://minio:9000
