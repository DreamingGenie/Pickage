FROM node:24-bookworm-slim AS node_runtime
FROM python:3.12-slim-bookworm

COPY --from=node_runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=node_runtime /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
COPY pipeline/minio/requirements.txt /tmp/pipeline/minio/requirements.txt
COPY pipeline/preprocessing/curated/requirements.txt /tmp/pipeline/preprocessing/curated/requirements.txt

RUN apt-get update \
 && apt-get install -y --no-install-recommends e2fsprogs util-linux \
 && rm -rf /var/lib/apt/lists/* \
 && pip install --no-cache-dir -r /tmp/pipeline/minio/requirements.txt \
 && pip install --no-cache-dir -r /tmp/pipeline/preprocessing/curated/requirements.txt \
 && useradd --uid 1000 --create-home --shell /usr/sbin/nologin pickage \
 && rm -rf /root/.cache

COPY pipeline/preprocessing/runtime/bounded_workspace.sh /usr/local/bin/bounded_workspace
COPY pipeline/preprocessing/runtime/resource_budget.sh /usr/local/bin/resource_budget.sh
COPY pipeline/preprocessing/runtime/workspace.role /usr/local/bin/workspace.role
RUN chmod 0755 /usr/local/bin/bounded_workspace
WORKDIR /opt/work

# Entrypoint is intentionally the root supervisor. It mounts only its dedicated
# volume and immediately drops the child to uid 1000 before user code runs.
ENTRYPOINT ["/usr/local/bin/bounded_workspace"]
