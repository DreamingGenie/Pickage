# `app` 노드(j15a506)의 환경 파일 원본.
#
# ⚠ **실제 파일은 체크아웃 안이 아니라 `/srv/pickage/app.env` 에 있다.** 체크아웃 안의
#   `deploy/prod/app/.env` 는 그것을 가리키는 심볼릭 링크고, 배포 잡이 매번 다시 건다.
#   배포가 CI 로 넘어가면서 작업 디렉터리가 매번 정리되기 때문이다.
#   만드는 절차는 ../README.md 의 "최초 1회 → 2. .env 를 만든다".
#
# 이 파일은 커밋되지 않는다(리포 전역 .gitignore). 서버에 한 번 두고 계속 쓴다.
# CI 는 이 파일을 만들지 않고 이미지 태그 두 줄만 갈아 끼운다 —
# DB 비밀번호를 CI 변수에 넣으면 파이프라인 수만큼 새어나갈 표면이 늘어난다.

# ── DB ────────────────────────────────────────────────
# ⚠ 로컬 compose 의 값(postgres / pickage)을 그대로 쓰지 말 것.
#   운영 비밀번호는 여기서 처음 만든다:  openssl rand -base64 24
POSTGRES_DB=pickage
POSTGRES_USER=pickage
POSTGRES_PASSWORD=

# ── API 이미지 태그 ───────────────────────────────────
# .gitlab-ci.yml 의 deploy-app 잡이 이 두 줄을 커밋 SHA 로 갈아 끼운다. 둘을 나눠 둔 이유는
# 프런트만 되돌리고 싶은 경우가 실제로 생기기 때문이다(API 는 멀쩡한데 화면만 깨진 배포).
#
# ⚠ **두 값이 서로 다른 것이 정상이다.** 배포 잡은 구운 이미지가 전과 같으면 그 줄을
#   되돌린다 — 프런트만 바뀐 머지에서 api 를 재시작시키지 않으려고.
#   "지금 서버에 뜬 커밋" 은 git -C /srv/pickage/repo log -1 이 답한다.
# 롤백은 이 값을 이전 SHA 로 되돌리고 다시 up 하는 것이 전부다.
# 그래서 오래된 태그의 이미지를 지우면 그 시점으로 못 돌아간다 (README 의 "정리" 절).
#
# 손으로 처음 띄울 때는 아무 값이나 넣으면 된다.
API_TAG=manual-01
WEB_TAG=manual-01

# ── MinIO 자격증명 ────────────────────────────────────
# ⚠ Spark worker② 의 executor 가 s3a 로 MinIO 를 읽고 쓴다.
#   이 값이 없으면 executor 만 NoAuthWithAWSException 으로 죽는다 —
#   worker 는 정상 등록되고 잡도 시작해서, 쓰기 단계에서야 드러난다.
#
# ⚠ **루트 자격증명을 넣지 말 것.** 이 노드는 인터넷에 노출된 유일한 노드다.
#   여기가 뚫리면 수집 데이터 전체를 잃는다.
#   data 노드에서 서비스 계정을 발급해 그 키를 넣는다:
#
#     docker compose exec minio sh -c 'mc alias set l http://127.0.0.1:9000 "$MINIO_ROOT_USER" "$MINIO_ROOT_PASSWORD" >/dev/null && mc admin user svcacct add l "$MINIO_ROOT_USER"'
#
#   변수 이름이 ROOT 인 것은 spark-env.sh 가 그 이름을 읽기 때문이고,
#   값은 서비스 계정 키다.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# ── Spark worker② (상시) ─────────────────────────────
# 이 노드는 배치 때 Spark worker 를 겸한다. `docker compose up -d` 에 같이 뜬다.
#
#   PRIVATE_IP         이 노드(app)의 사설 IP.  hostname -I 의 172.26.x.x
#   SPARK_MASTER_HOST  data 노드의 사설 IP (172.26.8.249)
#   SPARK_WORKER_CORES nproc 으로 확인한 값 이하. 사용자 트래픽도 받는 노드다
#   SPARK_WORKER_MEMORY worker 가 master 에게 **광고하는 풀 크기**. executor 힙이 아니다.
#                      ⚠ 이 값이 executor 힙의 상한이 되므로, 그 힙 + 비힙 + worker
#                        데몬이 mem_limit 6.5g 안에 들어와야 한다:
#                          executor 힙 5g + 비힙 ~0.6g + 데몬 ~1g ≈ 6.6g
#                        올리려면 mem_limit·memswap_limit 을 같이 올릴 것 —
#                        한쪽만 올리면 첫 풀사이즈 executor 에서 OOM Kill 이다
# hostname -I 로 재확인할 것. 인스턴스를 교체하면 바뀐다.
PRIVATE_IP=172.26.6.235
SPARK_MASTER_HOST=172.26.8.249
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=5g
