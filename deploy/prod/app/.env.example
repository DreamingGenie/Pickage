# `app` 노드(j15a506)의 환경 파일 원본.
#
# ⚠ **실제 파일은 체크아웃 안이 아니라 `/srv/pickage/app.env` 에 있다.** 체크아웃 안의
#   `deploy/prod/app/.env` 는 그것을 가리키는 심볼릭 링크고, 배포 잡이 매번 다시 건다.
#   배포가 CI 로 넘어가면서 작업 디렉터리가 매번 정리되기 때문이다.
#   만드는 절차는 ../README.md 의 "최초 1회 → 2. .env 를 만든다".
#
# 이 파일은 커밋되지 않는다(리포 전역 .gitignore). 서버에 한 번 두고 계속 쓴다.
# CI 는 이 파일을 만들지 않고 이미지 태그 두 줄만 갈아 끼운다 —
# DB 비밀번호를 CI 변수에 넣으면 파이프라인 수만큼 새어나갈 표면이 늘어난다.

# ── DB ────────────────────────────────────────────────
# ⚠ 로컬 compose 의 값(postgres / pickage)을 그대로 쓰지 말 것.
#   운영 비밀번호는 여기서 처음 만든다:  openssl rand -base64 24
POSTGRES_DB=pickage
POSTGRES_USER=pickage
POSTGRES_PASSWORD=

# ── API 이미지 태그 ───────────────────────────────────
# .gitlab-ci.yml 의 deploy-app 잡이 이 두 줄을 커밋 SHA 로 갈아 끼운다. 둘을 나눠 둔 이유는
# 프런트만 되돌리고 싶은 경우가 실제로 생기기 때문이다(API 는 멀쩡한데 화면만 깨진 배포).
#
# ⚠ **두 값이 서로 다른 것이 정상이다.** 배포 잡은 구운 이미지가 전과 같으면 그 줄을
#   되돌린다 — 프런트만 바뀐 머지에서 api 를 재시작시키지 않으려고.
#   "지금 서버에 뜬 커밋" 은 git -C /srv/pickage/repo log -1 이 답한다.
# 롤백은 이 값을 이전 SHA 로 되돌리고 다시 up 하는 것이 전부다.
# 그래서 오래된 태그의 이미지를 지우면 그 시점으로 못 돌아간다 (README 의 "정리" 절).
#
# 손으로 처음 띄울 때는 아무 값이나 넣으면 된다.
API_TAG=manual-01
WEB_TAG=manual-01

# ⚠ RAG_TAG는 아직 어떤 배포 잡도 안 갈아 끼운다(deploy-app은 API_TAG·WEB_TAG만 다룸,
#   2026-09-18 현재 ai/rag용 CI 잡 미착수) — 지금은 API_TAG·WEB_TAG의 "손으로 처음
#   띄울 때" 관례와 같은 자리다. rag-api 이미지 태그가 바뀌면 직접 여기를 고칠 것.
RAG_TAG=manual-01

# ── MinIO 자격증명 ────────────────────────────────────
# ⚠ Spark worker② 의 executor 가 s3a 로 MinIO 를 읽고 쓴다.
#   이 값이 없으면 executor 만 NoAuthWithAWSException 으로 죽는다 —
#   worker 는 정상 등록되고 잡도 시작해서, 쓰기 단계에서야 드러난다.
#
# ⚠ **루트 자격증명을 넣지 말 것.** 이 노드는 인터넷에 노출된 유일한 노드다.
#   여기가 뚫리면 수집 데이터 전체를 잃는다.
#   data 노드에서 서비스 계정을 발급해 그 키를 넣는다:
#
#     docker compose exec minio sh -c 'mc alias set l http://127.0.0.1:9000 "$MINIO_ROOT_USER" "$MINIO_ROOT_PASSWORD" >/dev/null && mc admin user svcacct add l "$MINIO_ROOT_USER"'
#
#   변수 이름이 ROOT 인 것은 spark-env.sh 가 그 이름을 읽기 때문이고,
#   값은 서비스 계정 키다.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# ── Spark worker② (상시) ─────────────────────────────
# 이 노드는 배치 때 Spark worker 를 겸한다. `docker compose up -d` 에 같이 뜬다.
#
#   PRIVATE_IP         이 노드(app)의 사설 IP.  hostname -I 의 172.26.x.x
#   SPARK_MASTER_HOST  data 노드의 사설 IP (172.26.8.249)
#   SPARK_WORKER_CORES nproc 으로 확인한 값 이하. 사용자 트래픽도 받는 노드다
#   SPARK_WORKER_MEMORY worker 가 master 에게 **광고하는 풀 크기**. executor 힙이 아니다.
#                      ⚠ 이 값이 executor 힙의 상한이 되므로, 그 힙 + 비힙 + worker
#                        데몬이 mem_limit 6.5g 안에 들어와야 한다:
#                          executor 힙 5g + 비힙 ~0.6g + 데몬 ~1g ≈ 6.6g
#                        올리려면 mem_limit·memswap_limit 을 같이 올릴 것 —
#                        한쪽만 올리면 첫 풀사이즈 executor 에서 OOM Kill 이다
# hostname -I 로 재확인할 것. 인스턴스를 교체하면 바뀐다.
PRIVATE_IP=172.26.6.235
SPARK_MASTER_HOST=172.26.8.249
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=5g

# ── 커뮤니티(GitHub) — 선택값 ─────────────────────────
# ⚠ 둘 다 비워도 컨테이너는 정상 기동한다. 필수값(POSTGRES_PASSWORD 등)과 달리
#   compose 가 `:-` 기본값으로 받는다.
#
#   GITHUB_COMMUNITY_TOKEN 이 없으면 비인증 GitHub 호출(10/분)로 자연 폴백한다.
#   넣으면 인증 호출(30/분)이 된다 — repo 쓰기 권한은 필요 없다, 스코프 없는
#   PAT 또는 fine-grained 토큰의 "Public repositories (read-only)" 면 충분하다.
#   POSTGRES_PASSWORD 와 같은 자격증명이다 — 팀 비밀 저장소에도 사본을 남길 것.
#
#   ⚠ COMMUNITY_ENABLED=true 로 켜도 GMS 요약 클라이언트(C1)가 아직 없어서
#   실제 새로고침 요청은 여전히 COMMUNITY_DISABLED 로 거절된다. 이 값들은
#   C1 구현 전까지는 화면 동작을 바꾸지 않는 사전 배선이다.
GITHUB_COMMUNITY_TOKEN=
COMMUNITY_ENABLED=false

# ── GMS(LLM 요약) — 선택값, 지금은 백엔드가 안 읽는다 ──────
# ⚠ GMS 요약 클라이언트(C1)가 아직 구현 전이다(FakeCommunitySummarizer만 존재) —
#   여기 값을 채워도 지금은 아무 코드도 이 값을 읽지 않는다. C1 구현 착수 시
#   이름이 그대로 쓰이는지부터 다시 확인할 것 — 아래는 구현계획 §설정과 보안이
#   제안한 목표값이고, 그 문서도 "실제로 존재한다고 주장하지 않는다"고 적어 뒀다.
#
#   GMS_API_KEY 는 팀이 이미 보유한 키다(신규 발급 아님) — GITHUB_COMMUNITY_TOKEN과
#   같은 자격증명이니 팀 비밀 저장소에도 사본을 남길 것.
GMS_API_KEY=
GMS_BASE_URL=
GMS_REQUEST_PATH=
GMS_AUTH_HEADER=
GMS_AUTH_SCHEME=
GMS_MODEL=

# ── 주간 수집 운영 API (S15P21A506-347) ────────────────────────
# 수집은 data 노드에서 돌고 상태는 그 노드의 MinIO 객체에 있다. api 가 그것을 읽어
# 운영자에게 보여 주고, 수동 실행 요청만 우편함 객체로 쓴다.
#
# ⚠ **위의 MINIO_ROOT_* 를 재사용하지 말 것.** 권한 폭이 전혀 다르다.
#   전용 계정은 _ops/weekly/ 를 읽고 그 아래 manual-request.json 만 쓴다 —
#   **run.json 에는 못 쓴다.** 그 객체의 필자는 수집 러너 하나뿐이어야 하기 때문이고,
#   규약이 아니라 권한으로 막아 두었다.
#   발급 절차는 deploy/prod/data/README.md 의 "app 노드 api 에 줄 계정" 절.
#
# ⚠ 안 채워도 배포는 성공하고 api 도 뜬다 — 이 값 하나로 사이트 전체를 내리지 않는다.
#   대신 ops API 만 "설정이 없습니다" 로 답한다. 붙인 뒤 한 번 눌러 확인할 것:
#     ssh -L 18080:localhost:8080 ...  &&  curl -s localhost:18080/api/v1/ops/weekly/runs
#
# ⚠ 이름 앞의 PICKAGE_ 는 장식이 아니다. 백엔드가 읽는 프로퍼티가
#   pickage.ops.s3.* 이고, 스프링이 **이름만으로** 이어 준다(PICKAGE_OPS_S3_ACCESS_KEY
#   -> pickage.ops.s3.access-key). 그래서 application-prod.yaml 에 배선이 없다.
#   이름을 줄이면 조용히 안 읽힌다 — 오류가 아니라 "설정이 없습니다" 로만 보인다.
#
# data 노드의 사설 IP. 위 PRIVATE_IP 는 이 노드(app)의 것이라 다르다.
PICKAGE_OPS_S3_ENDPOINT=http://172.26.8.249:9000
PICKAGE_OPS_S3_ACCESS_KEY=
PICKAGE_OPS_S3_SECRET_KEY=

# ── 백엔드 로더 (curated 읽기) — 소비자는 아직 없다 ─────────────
# curated Parquet 을 PostgreSQL 로 넣는 로더용 계정이다. **그 코드는 아직 없다**
# (deploy/ci/README.md 의 "아직 없는 것"). 그래도 미리 채워 두는 이유는, 코드가 생기는
# 날 서버를 다시 만질 일이 없게 하려는 것이다 — 이 값이 비어 있어도 아무 일도 안 난다.
#
# ⚠ **위의 MINIO_ROOT_* 도, PICKAGE_OPS_S3_* 도 재사용하지 말 것.** 앞엣것은 Spark
#   executor 용이라 권한이 넓고, 뒤엣것은 _ops/weekly/ 전용에 쓰기가 붙어 있다.
#   전용 계정 pickage-api-loader 는 pickage-curated 를 **읽기만** 한다
#   (pipeline/minio/policies/api-loader.json).
#   발급 절차는 deploy/prod/data/README.md 의 "app 노드 백엔드 로더에 줄 계정" 절.
#
# ⚠ 이름 앞의 PICKAGE_ 는 장식이 아니다. 위 PICKAGE_OPS_S3_* 와 같은 이유로,
#   스프링이 이름만으로 pickage.curated.s3.* 에 잇는다. **소비자 코드를 쓸 때 그 이름을
#   여기에 맞출 것** — 어긋나면 오류가 아니라 조용히 기본값으로 떨어진다.
#
# data 노드의 사설 IP. 위 PRIVATE_IP 는 이 노드(app)의 것이라 다르다.
PICKAGE_CURATED_S3_ENDPOINT=http://172.26.8.249:9000
PICKAGE_CURATED_S3_ACCESS_KEY=
PICKAGE_CURATED_S3_SECRET_KEY=
