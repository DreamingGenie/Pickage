# 운영 서버(#2)의 deploy/prod/app/.env 원본.
#
#   cd deploy/prod/app && cp .env.example .env    후 값을 채운다.
#
# .env 는 커밋되지 않는다(리포 전역 .gitignore). 서버에 한 번 두고 계속 쓴다.
# CI 는 이 파일을 만들지 않고 API_TAG 한 줄만 갈아 끼운다 —
# DB 비밀번호를 CI 변수에 넣으면 파이프라인 수만큼 새어나갈 표면이 늘어난다.

# ── DB ────────────────────────────────────────────────
# ⚠ 로컬 compose 의 값(postgres / pickage)을 그대로 쓰지 말 것.
#   운영 비밀번호는 여기서 처음 만든다:  openssl rand -base64 24
POSTGRES_DB=pickage
POSTGRES_USER=pickage
POSTGRES_PASSWORD=

# ── API 이미지 태그 ───────────────────────────────────
# 배포 job 이 이 두 줄을 커밋 SHA 로 갈아 끼운다. 둘을 나눠 둔 이유는
# 프런트만 되돌리고 싶은 경우가 실제로 생기기 때문이다(API 는 멀쩡한데 화면만 깨진 배포).
# 롤백은 이 값을 이전 SHA 로 되돌리고 다시 up 하는 것이 전부다.
# 그래서 오래된 태그의 이미지를 지우면 그 시점으로 못 돌아간다 (README 의 "정리" 절).
#
# 손으로 처음 띄울 때는 아무 값이나 넣으면 된다.
API_TAG=manual-01
WEB_TAG=manual-01

# ── Spark worker② (배치 시각만) ───────────────────────
# 평소에는 필요 없다. 배치를 붙일 때 채운다.
#
#   PRIVATE_IP         이 노드(app)의 사설 IP.  hostname -I 의 172.26.x.x
#   SPARK_MASTER_HOST  data 노드의 사설 IP (172.26.8.249)
#   SPARK_WORKER_CORES nproc 으로 확인한 값 이하. 사용자 트래픽도 받는 노드다
#   SPARK_WORKER_MEMORY executor 에 줄 양. mem_limit 6.5g 안에 들어와야 한다
PRIVATE_IP=
SPARK_MASTER_HOST=172.26.8.249
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=6g
