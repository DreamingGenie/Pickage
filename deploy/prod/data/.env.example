# `data` 노드의 deploy/prod/data/.env 원본.
#
#   cd deploy/prod/data && cp .env.example .env    후 값을 채운다.
#
# .env 는 커밋되지 않는다. 서버에 한 번 두고 계속 쓴다.

# ⚠ 지금 돌고 있는 MinIO 와 **같은 값**을 넣어야 한다. 새로 만들지 말 것.
#
# 루트 자격증명을 바꾸면 그동안 발급한 서비스 계정(액세스 키)이 못 쓰게 될 수 있다 —
# IAM 데이터가 데이터 디렉터리 안에서 루트 자격증명과 엮여 있다.
# 수집 스크립트가 그 키로 붙고 있으므로, 바꾸는 순간 수집이 멈춘다.
#
# 지금 값을 모르면 돌고 있는 컨테이너에서 꺼낸다:
#   docker inspect minio --format '{{range .Config.Env}}{{println .}}{{end}}' | grep MINIO_ROOT
#
# 자격증명 교체가 필요하면 이 이관과 **따로** 한다. 한꺼번에 하면 원인을 못 가린다.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# ── 노드 주소 ─────────────────────────────────────────
# 이 노드(data)의 사설 IP.  hostname -I 의 172.26.x.x 를 쓸 것 —
# 172.17.0.1 은 docker0 이라 상대 서버에서 안 보인다.
#
# MinIO 를 여기에도 바인딩하고(app 의 executor 가 s3a 로 읽는다),
# Spark master 가 이 주소를 광고한다.
PRIVATE_IP=172.26.8.249

# ── Spark worker① ────────────────────────────────────
# nproc 으로 확인한 값 이하로. 설계는 3코어/8g 를 잡았지만
# 이 노드의 실제 코어 수를 확인하고 맞출 것.
#
# ⚠ SPARK_WORKER_MEMORY 는 worker 가 master 에게 **광고하는 풀 크기**다. executor 힙이 아니다.
#   이 컨테이너의 mem_limit 10g 안에는 worker 데몬과 **driver** 도 같이 있다
#   (spark-submit 을 이 컨테이너에서 exec 한다 — README 의 "스모크 잡").
#
#     executor 힙 7g + 비힙 ~0.7g + driver 1g + 데몬 ~1g ≈ 9.7g   vs   10g
#
#   driver 몫은 submit 에서 --driver-memory 1g 로 **명시한다.** 기본값도 1g 이지만,
#   적어 두지 않으면 이 계산이 기본값에 의존하는 것을 아무도 모른다.
#   올리려면 mem_limit·memswap_limit 을 같이 올릴 것 — 한쪽만 올리면 OOM Kill 이다.
SPARK_WORKER_CORES=3
SPARK_WORKER_MEMORY=7g
