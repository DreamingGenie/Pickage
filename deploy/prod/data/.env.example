# `data` 노드의 deploy/prod/data/.env 원본.
#
#   cd deploy/prod/data && cp .env.example .env    후 값을 채운다.
#
# .env 는 커밋되지 않는다. 서버에 한 번 두고 계속 쓴다.
#
# `deploy-ai` 잡이 이 파일의 AI_TAG 를 고치므로, 실물은 러너가 쓸 수 있는
# /srv/pickage/data.env 에 두고 여기는 심볼릭 링크로 둔다 —
# 옮기는 절차는 deploy/ci/README.md 의 "배포 러너 — `data` 노드".

# ⚠ 지금 돌고 있는 MinIO 와 **같은 값**을 넣어야 한다. 새로 만들지 말 것.
#
# 루트 자격증명을 바꾸면 그동안 발급한 서비스 계정(액세스 키)이 못 쓰게 될 수 있다 —
# IAM 데이터가 데이터 디렉터리 안에서 루트 자격증명과 엮여 있다.
# 수집 스크립트가 그 키로 붙고 있으므로, 바꾸는 순간 수집이 멈춘다.
#
# 지금 값을 모르면 돌고 있는 컨테이너에서 꺼낸다:
#   docker inspect minio --format '{{range .Config.Env}}{{println .}}{{end}}' | grep MINIO_ROOT
#
# 자격증명 교체가 필요하면 이 이관과 **따로** 한다. 한꺼번에 하면 원인을 못 가린다.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# ── 노드 주소 ─────────────────────────────────────────
# 이 노드(data)의 사설 IP.  hostname -I 의 172.26.x.x 를 쓸 것 —
# 172.17.0.1 은 docker0 이라 상대 서버에서 안 보인다.
#
# MinIO 를 여기에도 바인딩하고(app 의 executor 가 s3a 로 읽는다),
# Spark master 가 이 주소를 광고한다.
PRIVATE_IP=172.26.8.249

# ── Spark worker① ────────────────────────────────────
# nproc 으로 확인한 값 이하로. 설계는 3코어/8g 를 잡았지만
# 이 노드의 실제 코어 수를 확인하고 맞출 것.
#
# ⚠ SPARK_WORKER_MEMORY 는 worker 가 master 에게 **광고하는 풀 크기**다. executor 힙이 아니다.
#   이 컨테이너의 mem_limit 10g 안에는 worker 데몬과 **driver** 도 같이 있다
#   (spark-submit 을 이 컨테이너에서 exec 한다 — README 의 "스모크 잡").
#
#     executor 힙 7g + 비힙 ~0.7g + driver 1g + 데몬 ~1g ≈ 9.7g   vs   10g
#
#   driver 몫은 submit 에서 --driver-memory 1g 로 **명시한다.** 기본값도 1g 이지만,
#   적어 두지 않으면 이 계산이 기본값에 의존하는 것을 아무도 모른다.
#   올리려면 mem_limit·memswap_limit 을 같이 올릴 것 — 한쪽만 올리면 OOM Kill 이다.
SPARK_WORKER_CORES=3
SPARK_WORKER_MEMORY=7g

# ── 유사도 배치 이미지 태그 ───────────────────────────
# app 노드의 API_TAG·WEB_TAG 와 같은 규칙이다. `deploy-ai` 잡이 커밋 SHA 로 갈아 끼운다
# (S15P21A506-339 — deploy/ci/README.md 의 "유사도 배치 이미지").
# 손으로 처음 돌릴 때는 아무 값이나 넣으면 된다.
#
# ⚠ 잡이 붙은 뒤로는 **이 줄을 손으로 고치지 않는다.** 고칠 때는 하나뿐 —
#   롤백으로 이전 SHA 를 되돌릴 때다. 그 명령도 위 README 에 있다.
#
# ⚠ **이 파일은 서버에 한 벌만 있어야 한다.** 잡은 /srv/pickage/data.env 를 고치고,
#   사람이 배치를 돌리는 ~/S15P21A506/deploy/prod/data/.env 는 그 파일을 가리키는
#   심볼릭 링크다. 두 벌이 되면 "배포했는데 옛 이미지로 돈다" 가 된다. 확인:
#     readlink -f ~/S15P21A506/deploy/prod/data/.env    # → /srv/pickage/data.env
AI_TAG=manual-01

# ── 유사도 배치 — 고정 값만 둔다 ──────────────────────
# ⚠ **날짜도 모델 버전도 여기 넣지 않는다.** 회차마다 바뀌는 값이라
#   run-similarity-batch.sh 가 포인터 둘을 읽어 확정한다:
#
#     코퍼스  $AI_CORPUS_PREFIX/_current.json   → run_path(코퍼스 경로) + run_id(산출물 이름)
#     모델    MLflow  $AI_MODEL_NAME@$AI_MODEL_ALIAS → s3:// 경로
#
#   새 코퍼스가 게시되거나 모델이 승격되면 다음 실행이 알아서 집는다.
#   이 파일을 고칠 일이 없다.

# 코퍼스가 사는 prefix. run 세그먼트는 붙이지 않는다.
# raw 가 pickage-raw/ecosystems-keywords/v1/collected_date=.../run_id=... 이므로
# 그 파생물은 같은 소스·버전 아래 데이터셋 이름을 하나 더 둔다.
AI_CORPUS_PREFIX=pickage-curated/ecosystems-keywords/v1/package-text

# 산출물. 아래에 model=vN/corpus=<run_id>/ 로 쌓인다.
AI_DST_RESULT=pickage-vectors

# MLflow 에서 어느 모델을 물어볼지. 승격은 MLflow 에서 하고 여기는 안 바뀐다.
AI_MODEL_NAME=pickage-similarity
AI_MODEL_ALIAS=production

# ── MLflow ────────────────────────────────────────────
# 이 노드에서 도는 MLflow. 배치 스크립트가 호스트에서 REST 로 부른다.
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# ── 주간 수집 (ingest-weekly) ─────────────────────────
# 회차마다 바뀌는 값은 여기 없다. 무엇을 받을지는 회차 날짜(그 주 월요일) 하나에서
# 유도되고, 어디까지 했는지는 MinIO 의 상태 객체가 안다.
#
#   pickage-raw/_ops/weekly/<week_of>/run.json
#
# 수집기 User-Agent 에 실리는 연락처. npm·ecosyste.ms 가 문제 있는 클라이언트를
# 차단하기 전에 연락할 수 있어야 한다는 예의이자, 우리가 차단당하지 않는 방법이다.
# 비어 있으면 수집기가 시작하지 않는다.
OSS_SHIFT_UA_CONTACT=

# ── 이 노드에 손으로 만들어 두는 것 (커밋되지 않는다) ─────
#
#   1. MinIO 자격증명 파일 — 컨테이너가 파일로 읽는다(환경변수가 아니다)
#        cp pipeline/minio/.env.data.example pipeline/minio/.env.data
#
#   2. 산출물 디렉터리 — 주당 약 10 GB. 컨테이너가 uid 1000 으로 돌기 때문에
#      소유권을 넘겨 두지 않으면 Docker 가 root 소유로 만들어 쓰기가 막힌다.
#        sudo mkdir -p /srv/pickage/ingest-work
#
#   3. GCP 서비스 계정 키 — 파이썬 클라이언트와 gcloud CLI 가 둘 다 이 파일을 본다
#        sudo mkdir -p /srv/pickage/secrets
#        # 키를 /srv/pickage/secrets/gcp-service-account.json 으로 둔다
#
#   1~3 을 마친 뒤 한 번:
#        sudo chown -R 1000:1000 /srv/pickage/ingest-work /srv/pickage/secrets
#        sudo chown 1000:1000 /srv/pickage/secrets/gcp-service-account.json
#
#   ⚠ 부모 /srv/pickage 를 통째로 chown 하지 말 것. 거기엔 배포 러너가 쓰는
#     data.env 가 gitlab-runner 소유로 들어 있다 — 넘기면 deploy-ai 잡이
#     AI_TAG 를 못 고쳐 유사도 배치 배포가 실패한다 (deploy/ci/README.md).
#
# ⚠ MinIO 데이터와 같은 파티션이다. `df -h /` 를 감시 항목에 넣을 것 —
#   채우면 수집만 멈추는 게 아니라 저장소가 통째로 선다.
