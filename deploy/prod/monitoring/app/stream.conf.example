# `app` 노드(j15a506) parent 의 스트리밍 수신 설정 — **원본**
#
#   cp stream.conf.example stream.conf
#
# ⚠ 실제 `stream.conf` 는 커밋되지 않는다(API 키가 들어간다). 저장소 .gitignore 가 막는다.
#   양 노드의 stream.conf 에 **같은 키**를 넣어야 하므로, 만든 키는 팀 비밀 저장소에 남긴다.
#   서버의 파일이 유일본이면 서버를 갈아엎을 때 두 노드를 다시 짝지을 근거가 사라진다.
#
# Phase 1(=`app` 한 노드)에서는 이 파일이 아무 일도 하지 않는다. 받을 child 가 없다.
# 그래도 두는 이유는 compose 가 이 경로를 마운트하기 때문이다 — 없으면 Docker 가
# **디렉터리를 대신 만들어** 붙이고, netdata 는 설정을 못 읽는다.

# ── 키 만들기 (한 번, 아무 노드에서) ────────────────────────────
#   uuidgen
#
# ⚠ 이건 비밀번호가 아니라 **두 노드를 짝짓는 식별자**다. 아무 문자열이나 넣으면
#   netdata 가 거부한다 — UUID 형식이어야 한다.

# 아래 대괄호 안을 만든 키로 바꾼다. 섹션 이름 자체가 API 키다.
[00000000-0000-0000-0000-000000000000]
    enabled = yes

    # ⚠ **보안그룹과 별개인 두 번째 겹이다.** 보안그룹 규칙을 누가 넓게 고쳐도
    #   여기서 한 번 더 막힌다. 172.26.8.249 는 `data` 노드의 사설 IP 다.
    allow from = 172.26.8.249

    # child 가 보낸 것을 parent 의 dbengine 에 쌓는다. child 는 ram 모드라
    # **여기가 `data` 노드 메트릭의 유일한 보관처다** (../README.md Phase 4 "감수하는 것").
    default memory mode = dbengine

    # child 노드에 대한 알람도 parent 가 평가한다. child 에서 따로 돌리지 않는다 —
    # 같은 알람이 두 번 뜨는 것을 막는다.
    health enabled by default = auto
