# `app` 노드 모니터링 스택의 환경 파일 원본.
#
#   cp .env.example .env
#
# 이 파일은 커밋되지 않는다(리포 전역 .gitignore 의 `.env` 규칙).
#
# ⚠ 운영 스택의 `/srv/pickage/app.env` 와 **다른 파일이다.** 그쪽은 배포 잡이 매번
#   태그를 갈아 끼우느라 체크아웃 밖에 두지만, 모니터링은 CI 가 배포하지 않으므로
#   그럴 이유가 없다. 여기서는 compose.yaml 옆에 그냥 둔다.
#
# 비밀은 하나도 없다. 그래도 `.env` 인 이유는 **값이 노드마다 다르기 때문**이다.

# ── 호스트의 docker 그룹 GID ──────────────────────────────────
# 서버에서 값을 얻는다:
#     getent group docker | cut -d: -f3
#
# ⚠ 이 값이 틀리면 컨테이너는 정상으로 뜨고 차트도 나오는데 **컨테이너 이름만 안 보인다**
#   (cgroup ID 12자리로 나온다). 오류가 아니라 "덜 나오는" 것으로 드러나므로,
#   띄운 뒤 ../README.md 4절의 확인 명령을 반드시 한 번 돌릴 것.
#
# ⚠ 두 노드의 값이 같다는 보장이 없다. 각 노드에서 각각 확인한다.
DOCKER_GID=

# ── 파이프라인 모니터의 MinIO 계정 ───────────────────────────
# 전용 계정 pickage-monitor. 만드는 법은 ../../data/README.md 의 "파이프라인 모니터에 줄 계정"
# (계정은 data 노드의 MinIO 에서 만들고, 값을 두 노드의 .env 에 같이 넣는다).
# 목록은 전 버킷, 읽기는 _ops/ 와 _current.json 뿐. **쓰기는 없다** — 읽기 전용 계정이다
# (pipeline/minio/policies/monitor.json). ⚠ 루트 키를 넣지 말 것.
#
# data 노드의 사설 IP 다 — similarity-loader 가 쓰는 것과 같은 주소 (../../README.md).
MONITOR_S3_ENDPOINT=http://172.26.8.249:9000
MONITOR_S3_ACCESS_KEY=
MONITOR_S3_SECRET_KEY=
