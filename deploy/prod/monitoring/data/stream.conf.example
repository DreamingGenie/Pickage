# `data` 노드(j15a506a) child 의 스트리밍 발신 설정 — **원본**
#
#   cp stream.conf.example stream.conf
#
# ⚠ 실제 `stream.conf` 는 커밋되지 않는다(API 키가 들어간다).
#   **`app` 쪽 stream.conf 의 대괄호 안과 글자 하나까지 같은 키**여야 한다.
#   다르면 parent 가 연결을 끊고, 증상은 "이 노드만 화면에 안 나옴" 이다.

[stream]
    enabled = yes

    # parent 의 **사설 IP** 다. 공인 도메인(j15a506.p.ssafy.io)을 쓰지 않는다 —
    # 19999 는 인터넷에 열려 있지 않고, 열 생각도 없다 (../README.md 5절).
    #
    # ⚠ 이 주소로 나가려면 `app` 노드 보안그룹에 인바운드 19999(출처 172.26.8.249)가
    #   있어야 한다. 없으면 **연결이 거부가 아니라 타임아웃**으로 끝나서,
    #   로그에 아무것도 안 남고 그냥 노드가 안 나타난다.
    destination = 172.26.6.235:19999

    # ../app/stream.conf 의 대괄호 안과 같은 값으로 바꾼다.  키 만들기: uuidgen
    api key = 00000000-0000-0000-0000-000000000000

    # parent 가 끊겼을 때 메모리에 얼마나 들고 버틸지. 넘치면 오래된 것부터 버린다.
    # ⚠ 이 버퍼는 compose 의 mem_limit 256m **안에서** 잡힌다. 늘리려면 둘을 같이 올린다.
    buffer size bytes = 10485760

    # 배포·재시작으로 parent 가 잠깐 없을 때 너무 몰아치지 않게 한다.
    reconnect delay seconds = 5
