# 컨테이너 안에서 실행·해석되는 파일은 반드시 LF 여야 한다.
#
# Windows 에서 core.autocrlf=true 로 체크아웃하면 CRLF 로 바뀌는데,
# 컨테이너의 sh 는 줄 끝 \r 을 명령의 일부로 읽어 그대로 죽는다.
# 증상이 "왜 이 스크립트가 갑자기 안 되지" 로 나타나 원인 찾기 어렵다.
*.sh    text eol=lf
*.conf  text eol=lf

# systemd 유닛과 서버에서 `.` 로 읽거나 파싱하는 env 원본. 같은 이유다 —
# CRLF 로 내려오면 systemd 는 값 끝에 \r 을 붙이고, sh 는 변수 끝에 \r 을 남기며,
# .env 를 직접 파싱하는 파이썬(pipeline/minio/ingest_raw.py 의 client())은 비밀번호
# 끝에 \r 을 달고 인증에 실패한다. 셋 다 "값이 맞는데 왜 안 되지" 로 나타난다.
*.service    text eol=lf
*.timer      text eol=lf
*.example    text eol=lf

# 마이그레이션 SQL 은 Flyway 가 체크섬을 계산한다.
# 줄바꿈이 OS 마다 다르면 같은 파일인데 체크섬이 달라져
# 다른 OS 팀원의 DB 에서 검증이 실패한다.
*.sql   text eol=lf

# 저장소 지표 모듈은 코드의 원본 바이트를 해시한다. 승인 실행과 같은 LF를 유지한다.
pipeline/repository_metrics/*.py text eol=lf

# Windows 전용 스크립트는 CRLF 여야 한다.
*.bat   text eol=crlf
*.cmd   text eol=crlf

*.jar     binary
*.parquet binary

# git hook 은 확장자가 없어 위 *.sh 규칙에 걸리지 않는다.
# CRLF 로 체크아웃되면 sh 가 줄 끝 \r 을 명령의 일부로 읽어 훅이 통째로 죽는다.
.githooks/*  text eol=lf
