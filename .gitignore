# 환경 secret 파일(실제 값) — .env.example 류만 추적, 리포 전역 방어
# .env.server 처럼 앞으로 늘어날 환경 파일까지 한 번에 막는다.
# 서버 자격증명이 담기는 파일이라, 이름을 하나씩 추가하는 방식은 빠뜨리면 그대로 커밋된다.
.env
.env.*
!.env.example
!.env.*.example

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node
node_modules/
dist/

# OS / Editor
.DS_Store
.idea/

# AI 도구가 대화 중 임시로 만든 화면 출력 — 제품 자산·검수 근거가 아니다.
/Claude outputs/

# Bulk raw poll history from the Phase 0/1 spike harness — stays local per
# baseline/phase0/scripts/spikes/README.md's own convention. Curated,
# representative samples belong in data/samples/examples/ instead (tracked).
docs/history/journey_reliability_docs_v2/baseline/phase0/data/samples/*
!docs/history/journey_reliability_docs_v2/baseline/phase0/data/samples/examples/

# 수집 데이터 — 로컬에만 보관, 커밋하지 않음 (Bronze 원문/메타)
/data/

# AI 로컬 데이터·모델 산출물 — 실행 노드(GPU/EC2)에만, 커밋 금지
/ai/data/
/ai/**/*.parquet
/ai/**/*.onnx
/ai/**/*.onnx.data
/ai/**/onnx_bge_*/

# BigQuery 작업용 로컬 venv
.venv-bq/

# 이동쌍 재분류 대조 실행 결과 (S15P21A506-349) — 커밋하지 않음
# build_migration_pairs.py --source registry --kind regular 를 필터만 바꿔 두 번 돌린 중간물이다.
# 값이 있는 것은 두 실행의 '차이'뿐이고, 그 차이는 compare_reclassify_effect.py 가
# datasets/migration_pairs_dev_260914/reclassify_effect_* 로 뽑아 추적한다.
# 재현: 위 두 명령 + compare_reclassify_effect.py (각 3~6분)
/datasets/migration_pairs_regular_260914/
/datasets/migration_pairs_regular_legacy_260914/

# 확장 대상 46.9만 회차의 dependents 요약 CSV (S15P21A506-454) — 50 MB 라 추적하지 않는다.
# datasets/README.md 의 "수십 MB 이상, 재생성 가능한 것은 data/ 에 두고 공유한다" 규칙이고,
# 현재 추적 중인 가장 큰 CSV 가 기본 회차의 13.4 MB 다. 같은 폴더의 README·stats.json 은
# 추적한다. 재현: build_package_dependents.py --targets ... --label exp460k_260922 (93초)
/datasets/package_dependents_exp460k_260922/dependents_summary.csv

# Netdata 스트리밍 API 키가 담기는 파일 — *.example 만 추적한다.
# .env 류가 아니라 위의 전역 규칙에 안 걸린다. 두 노드가 같은 키를 공유하므로
# 한 번 커밋되면 두 노드를 다 다시 짝지어야 한다.
deploy/prod/monitoring/*/stream.conf

# 로컬 리허설에서 sed 로 만들어 쓰는 사본 — 저장소의 netdata.conf 와 갈리면 안 되므로
# 커밋하지 않고 매번 만든다. 만드는 법은 deploy/prod/monitoring/README.md 의 "로컬 리허설".
deploy/prod/monitoring/*/netdata.rehearsal.conf
